{
  "name": "meshmarauder-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:mac": "electron-builder --mac dmg zip --x64"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.bacondisk22.meshmarauder",
    "productName": "Mesh Marauder",
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "style.css",
      "renderer.js",
      "package.json",
      "usb-transport.cjs",
      "tcp-transport.cjs",
      "radio-input.cjs",
      "meshtastic-framing.cjs",
      "meshtastic-session.cjs",
      "meshtastic-codec.cjs",
      "packet-monitor.cjs",
      "connection-diagnostics.cjs",
      "ble-transport.cjs",
      "connection-retry.cjs"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Mesh Marauder connects to authorized Meshtastic radios using Bluetooth."
      }
    }
  },
  "dependencies": {
    "serialport": "^12.0.0",
    "@bufbuild/protobuf": "^2.6.3",
    "@meshtastic/protobufs": "npm:@jsr/meshtastic__protobufs@^2.7.0"
  }
}
